        "id": "ae1a22b1-3697-4f13-ab0b-f9812fbee244",
        "name": "Consultar facturas existentes",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          1040,
          300
        ],
        "credentials": {
          "httpBearerAuth": {
            "id": "P1x5o9V2k4a7b3c8",
            "name": "ERP API - pruebas"
          }
        }
      },
      {
        "parameters": {
          "mode": "runOnceForAllItems",
          "jsCode": "const api = $('Extraer datos del PDF').first().json;\nconst body = api.body || {};\nconst invoice = body.invoice || {};\nconst provider = $('Consultar proveedor').first().json;\nconst po = $('Consultar orden de compra').first().json;\nconst existingResult = $('Consultar facturas existentes').first().json;\nconst reasons = [];\nif (!invoice.invoice_number || !invoice.ruc || !invoice.date || !invoice.purchase_order || invoice.subtotal == null || invoice.tax == null || invoice.total == null) {\n  reasons.push(body.message || 'No se pudieron extraer todos los datos obligatorios de la factura.');\n}\nif (api.statusCode !== 201 || (invoice.status && invoice.status !== 'processed')) {\n  const details = Array.isArray(invoice.validation_errors) ? invoice.validation_errors.join('; ') : '';\n  reasons.push(details || body.message || 'La factura requiere revisión y no puede registrarse.');\n}\nif (provider.statusCode !== 200) reasons.push(`No se encontró el proveedor ${invoice.ruc || 'del RUC indicado'} en el ERP.`);\nelse if (String(provider.body?.estado || '').toUpperCase() !== 'ACTIVO') reasons.push(`El proveedor ${invoice.ruc} existe, pero no está activo.`);\nif (po.statusCode !== 200) reasons.push(`No se encontró la orden de compra ${invoice.purchase_order || 'indicada'} en el ERP.`);\nelse {\n  const orderBody = po.body || {};\n  if (orderBody.ruc_proveedor !== invoice.ruc) reasons.push('La orden de compra pertenece a un RUC distinto al emisor de la factura.');\n  if (String(orderBody.estado || '').toUpperCase() !== 'APROBADA') reasons.push(`La orden de compra ${invoice.purchase_order} no está aprobada.`);\n  const close = (a,b) => Math.abs(Number(a)-Number(b)) <= 0.02;\n  if (!close(orderBody.subtotal, invoice.subtotal) || !close(orderBody.iva, invoice.tax) || !close(orderBody.total, invoice.total)) reasons.push('Los importes de la factura no coinciden con la orden de compra.');\n}\nconst records = Array.isArray(existingResult.body) ? existingResult.body : [];\nif (existingResult.statusCode !== 200) reasons.push('No se pudo consultar el historial de facturas del ERP.');\nelse if (records.some(r => r.ruc === invoice.ruc && r.numero_factura === invoice.invoice_number)) reasons.push(`La factura ${invoice.invoice_number || ''} ya está registrada en el ERP.`);\nreturn [{json:{invoice, ok:reasons.length===0, reason:reasons.join(' '), run_mode:($('Leer modo de corrida').first().json.body?.run_mode || 'dry')}}];"
        },
