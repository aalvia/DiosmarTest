APP_NAME=Diosmar Document Automation
DATABASE_URL=sqlite:///./diosmar.db
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# python = patrones sin modelo; ai = Ollama (usar ai en la corrida final)
EXTRACTION_MODE=ai
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_TIMEOUT_SECONDS=180

# dry nunca hace alta ERP ni envía correo; live requiere integración configurada
RUN_MODE=dry
ERP_BASE_URL=http://192.168.15.113:8000
HTTP_TIMEOUT_SECONDS=10
# ERP_TOKEN se configura solo en .env local / credenciales seguras de n8n.
